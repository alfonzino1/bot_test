# ── Хронос: пример конфигурации ───────────────────────────────────────────────
# Скопируй в .env и заполни BOT_TOKEN. Секреты в коде не хранятся никогда.

# Токен от @BotFather (обязателен для запуска бота)
BOT_TOKEN=123456:AA-your-token-here

# Уровень логов: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Фоновая очередь логов (нужна только для многопоточных сценариев)
LOG_ENQUEUE=false

# Строка подключения. SQLite по умолчанию, PostgreSQL — замена одной строки.
# DATABASE_URL=postgresql+asyncpg://chronos:secret@localhost:5432/chronos
DATABASE_URL=sqlite+aiosqlite:///./data/chronos.db

# Таймзона по умолчанию (используется до онбординга)
DEFAULT_TIMEZONE=Europe/Moscow

# Необязательный белый список Telegram ID (мультиюзер задел).
# Пусто = бот открыт. Пример: ALLOWED_TELEGRAM_IDS=123456789,987654321
ALLOWED_TELEGRAM_IDS=

# Тишина и расписания задач (локальное время пользователя, ЧЧ:ММ)
MORNING_DIGEST_AT=08:00
EVENING_DIGEST_AT=20:30
AUTOSTOP_AT=23:00
WEEKLY_REPORT_AT=09:00

# Сколько дней вперёд материализуются напоминания
REMINDER_HORIZON_DAYS=7
